{
  "name": "deluge-lsp",
  "displayName": "Deluge Language Server",
  "description": "Language server for Zoho Deluge with completions, hover, diagnostics, and signature help",
  "version": "0.1.0",
  "publisher": "bcvictory",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:deluge"
  ],
  "contributes": {
    "languages": [
      {
        "id": "deluge",
        "aliases": [
          "Deluge",
          "deluge"
        ],
        "extensions": [
          ".dg",
          ".ds",
          ".deluge"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "deluge",
        "scopeName": "source.deluge",
        "path": "./syntaxes/deluge.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "deluge",
        "path": "./snippets/deluge.json"
      }
    ],
    "themes": [
      {
        "label": "Deluge Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/deluge-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Deluge Language Server",
      "properties": {
        "deluge.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Deluge language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0"
  }
}
