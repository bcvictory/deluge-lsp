  },
  "Min Value": {
    "prefix": "min",
    "body": [
      "${1:minimum} = min(${2:num1}, ${3:num2});"
    ],
    "description": "Find minimum value"
  },
  "Duplicate Collection": {
    "prefix": "duplicate",
    "body": [
