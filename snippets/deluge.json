  },
  "Days Between": {
    "prefix": "daysbetween",
    "body": [
      "${1:diff} = daysBetween(${2:startDate}, ${3:endDate});"
    ],
    "description": "Calculate days between two dates"
  },
  "Random Number": {
    "prefix": "random",
    "body": [
      "${1:rand} = randomNumber(${2:min}, ${3:max});"
    ],
    "description": "Generate random number in range"
  },
  "Distinct List": {
    "prefix": "distinct",
    "body": [
      "${1:uniqueList} = ${2:myList}.distinct();"
    ],
    "description": "Remove duplicates from list"
  },
  "Sort List": {
    "prefix": "sortlist",
    "body": [
      "${1:sortedList} = ${2:myList}.sort();"
    ],
    "description": "Sort list in ascending order"
  },
  "List Average": {
    "prefix": "average",
    "body": [
      "${1:avg} = ${2:numberList}.average();"
    ],
    "description": "Calculate average of number list"
  },
  "AES Encode": {
    "prefix": "aesencode",
    "body": [
      "${1:encrypted} = aesEncode(\"${2:encryption_key}\", ${3:data});"
    ],
    "description": "Encrypt data using AES 256-bit"
  },
  "AES Decode": {
    "prefix": "aesdecode",
    "body": [
      "${1:decrypted} = aesDecode(\"${2:encryption_key}\", ${3:encryptedData});"
    ],
    "description": "Decrypt data using AES 256-bit"
  },
  "URL Encode": {
    "prefix": "urlencode",
    "body": [
      "${1:encoded} = urlEncode(${2:text});"
    ],
    "description": "URL encode text"
  },
  "URL Decode": {
    "prefix": "urldecode",
    "body": [
      "${1:decoded} = urlDecode(${2:encodedText});"
    ],
    "description": "URL decode text"
  },
  "Proper Case": {
    "prefix": "proper",
    "body": [
      "${1:titleCase} = ${2:text}.proper();"
    ],
    "description": "Convert to title case"
  },
  "Left String": {
    "prefix": "left",
    "body": [
      "${1:prefix} = ${2:text}.left(${3:count});"
    ],
    "description": "Get leftmost characters"
  },
  "Right String": {
    "prefix": "right",
    "body": [
      "${1:suffix} = ${2:text}.right(${3:count});"
    ],
    "description": "Get rightmost characters"
  },
  "Reverse String": {
    "prefix": "reverse",
    "body": [
      "${1:reversed} = ${2:text}.reverse();"
    ],
    "description": "Reverse string"
  },
